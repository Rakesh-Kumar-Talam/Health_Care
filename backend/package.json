{
  "name": "curapulse-backend",
  "version": "1.0.0",
  "description": "Backend API for CuraPulse Healthcare Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
